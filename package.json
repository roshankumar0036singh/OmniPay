{
  "name": "omnipay-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@omnipay/backend",
    "dev:extension": "npm run dev --workspace=@omnipay/extension",
    "build": "npm run build --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --composite false"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@vitest/ui": "^4.0.18",
    "eslint": "^4.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "plasmo": "0.90.5"
  }
}
